   ],
   [
    "Trainingen",
    "Dinsdag en donderdag op het kunstgrasveld, samen met Elspeet 2"
   ],
   [
    "Thuiswedstrijden",
    "Zaterdag 14:30 op het hoofdveld, met elke week de pupil van de week langs de lijn"
   ]
