# Instellingen voor scheids.vv-elspeet.nl (Apache bij Vimexx). Wordt mee geüpload door .github/workflows/vimexx.yml.

# De doorstuurregels van de clubsite (public_html) gelden hier niet: die stuurden een ontbrekend
# bestand naar een index.php die hier niet bestaat, met een 500 als gevolg.
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# Eigen 404-pagina.
ErrorDocument 404 /404.html

# Het bestand waarmee de upload bijhoudt wat er al staat, hoeft niemand te zien.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Altijd even bij de server navragen of er een nieuwe versie is, zodat updates meteen op de telefoons komen.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
